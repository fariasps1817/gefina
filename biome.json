{
    "$schema": "./node_modules/@biomejs/biome/configuration.schema.json",
    "formatter": {
        "indentStyle": "space",
        "indentSize": 4
    },
"javascript": {
        "formatter": {
            "quoteStyle": "single", 
            "semicolons": "always",
            "trailingCommas": "none"
        }
    },

    "linter": {
        "enabled":true, 
        "rules": {
            "no-unused-vars": "error",
            "no-undef": "error",
            "no-console": "warn"
        }
    
    }
}